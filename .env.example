# Database configuration (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Admin Authentication (Set a strong, unique secret in production)
ADMIN_PASSWORD="REPLACE_WITH_SECURE_OWNER_PASSWORD"
ADMIN_SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_JWT_SECRET"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Store Checkout Features
ENABLE_COD="true"
ENABLE_WHATSAPP_CHECKOUT="true"
